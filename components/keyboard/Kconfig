menu "TEF Keyboard Configuration"

    config TEF_DEBUG_LATENCY_PIN
        int "Latency Debug Output GPIO Pin (-1 to disable)"
        default -1
        range -1 48
        help
            GPIO pin toggled when a new keypress enters the NKRO report.
            Connect to a logic analyzer together with the key switch
            to measure internal matrix scanning and debouncing latency.
            Set to -1 to disable.

    config TEF_MATRIX_SETTLE_US
        int "Matrix column settle time (microseconds)"
        default 20
        range 1 100
        help
            Delay in microseconds after asserting a column pin before reading row pins.
            Default is 20 us (~13 us estimated RC time constant).

    config TEF_EAGER_DEBOUNCE
        bool "Enable eager debouncing (immediate keypress on first scan)"
        default y
        help
            When enabled, a detected keypress is confirmed immediately on the first
            scan (or after TEF_PRESS_CONFIRM_SCANS), reducing input latency from ~4-5 ms
            to <1.2 ms. Release requires TEF_RELEASE_DEBOUNCE_SCANS consecutive low scans.

    config TEF_PRESS_CONFIRM_SCANS
        int "Scans required to confirm keypress"
        default 1
        range 1 10
        depends on TEF_EAGER_DEBOUNCE
        help
            Number of consecutive active scans required before confirming a press.
            Default is 1 (immediate lowest latency). Set to 2 to filter aggressive EMI glitches.

    config TEF_RELEASE_DEBOUNCE_SCANS
        int "Scans required to confirm key release"
        default 5
        range 1 20
        help
            Number of consecutive inactive scans required before releasing a key.
            Default is 5 scans (5 ms at 1000 Hz).

endmenu
